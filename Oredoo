const CONFIG = {
  // ==========================================================
  // CDN
  // ==========================================================
  TARGET_CDN: "https://shtvgo-prod.gcdn.co",

  // ==========================================================
  // HEADERS KE ORIGIN
  // ==========================================================
  USER_AGENT:
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36",

  REFERER: "https://www.starhub.com/",
  ORIGIN: "https://www.starhub.com/",

  // Header tambahan yang memang diperlukan.
  EXTRA_HEADERS: {}
};


// ============================================================
// WORKER
// ============================================================

export default {
  async fetch(request) {
    const requestURL = new URL(request.url);

    // --------------------------------------------------------
    // CORS PREFLIGHT
    // --------------------------------------------------------
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders()
      });
    }

    // --------------------------------------------------------
    // Hanya GET / HEAD
    // --------------------------------------------------------
    if (
      request.method !== "GET" &&
      request.method !== "HEAD"
    ) {
      return new Response("Method Not Allowed", {
        status: 405,
        headers: corsHeaders()
      });
    }

    // --------------------------------------------------------
    // Target origin
    // --------------------------------------------------------
    const targetURL =
      CONFIG.TARGET_CDN +
      requestURL.pathname +
      requestURL.search;

    // --------------------------------------------------------
    // REQUEST HEADERS
    // --------------------------------------------------------
    const upstreamHeaders = new Headers();

    upstreamHeaders.set(
      "User-Agent",
      CONFIG.USER_AGENT
    );

    upstreamHeaders.set(
      "Referer",
      CONFIG.REFERER
    );

    upstreamHeaders.set(
      "Origin",
      CONFIG.ORIGIN
    );

    // --------------------------------------------------------
    // Forward header yang memang berguna untuk media request
    // --------------------------------------------------------
    const forwardHeaders = [
      "Range",
      "If-Range",
      "If-None-Match",
      "If-Modified-Since",
      "Accept",
      "Accept-Language",
      "Cookie",
      "Authorization",
      "X-Requested-With"
    ];

    for (const name of forwardHeaders) {
      const value = request.headers.get(name);

      if (value) {
        upstreamHeaders.set(name, value);
      }
    }

    // --------------------------------------------------------
    // Extra headers
    // --------------------------------------------------------
    for (const [key, value] of Object.entries(
      CONFIG.EXTRA_HEADERS
    )) {
      if (value !== undefined && value !== null) {
        upstreamHeaders.set(key, String(value));
      }
    }

    try {
      // ======================================================
      // FETCH UPSTREAM
      // ======================================================

      const upstreamResponse = await fetch(
        targetURL,
        {
          method: request.method,
          headers: upstreamHeaders,
          redirect: "follow"
        }
      );

      // ======================================================
      // RESPONSE HEADERS
      // ======================================================

      const responseHeaders =
        new Headers(upstreamResponse.headers);

      applyCors(responseHeaders);

      // Header yang dapat mengganggu browser/player
      responseHeaders.delete(
        "x-frame-options"
      );

      responseHeaders.delete(
        "content-security-policy"
      );

      // ======================================================
      // HEAD
      // ======================================================

      if (request.method === "HEAD") {
        return new Response(null, {
          status: upstreamResponse.status,
          statusText: upstreamResponse.statusText,
          headers: responseHeaders
        });
      }

      // ======================================================
      // ERROR UPSTREAM
      // ======================================================

      if (!upstreamResponse.ok) {
        return new Response(
          upstreamResponse.body,
          {
            status: upstreamResponse.status,
            statusText: upstreamResponse.statusText,
            headers: responseHeaders
          }
        );
      }

      // ======================================================
      // CEK MPD
      // ======================================================

      const isMPD =
        requestURL.pathname
          .toLowerCase()
          .endsWith(".mpd");

      if (!isMPD) {
        return new Response(
          upstreamResponse.body,
          {
            status: upstreamResponse.status,
            statusText: upstreamResponse.statusText,
            headers: responseHeaders
          }
        );
      }

      // ======================================================
      // FINAL UPSTREAM URL
      // ======================================================

      const finalURL =
        upstreamResponse.url || targetURL;

      const finalParsedURL =
        new URL(finalURL);

      // ======================================================
      // BACA MPD
      // ======================================================

      let mpd =
        await upstreamResponse.text();

      // ======================================================
      // WORKER ORIGIN
      // ======================================================

      const workerOrigin =
        requestURL.origin;

      // ======================================================
      // BASE DIRECTORY DARI URL FINAL
      // ======================================================

      const finalManifestDir =
        new URL(
          "./",
          finalURL
        ).toString();

      // ======================================================
      // REWRITE MPD
      // ======================================================

      mpd = rewriteMPD({
        mpd,
        finalURL,
        finalParsedURL,
        finalManifestDir,
        workerOrigin
      });

      // ======================================================
      // HEADER SETELAH BODY DIUBAH
      // ======================================================

      responseHeaders.delete(
        "content-length"
      );

      responseHeaders.delete(
        "content-encoding"
      );

      responseHeaders.set(
        "Content-Type",
        "application/dash+xml; charset=utf-8"
      );

      // ======================================================
      // RETURN MPD
      // ======================================================

      return new Response(
        mpd,
        {
          status: upstreamResponse.status,
          statusText: upstreamResponse.statusText,
          headers: responseHeaders
        }
      );

    } catch (error) {

      // ======================================================
      // ERROR
      // ======================================================

      return new Response(
        "Proxy Error: " +
        (error?.message || String(error)),
        {
          status: 502,
          headers: {
            "Content-Type":
              "text/plain; charset=utf-8",
            ...corsHeaders()
          }
        }
      );
    }
  }
};


// ============================================================
// MPD REWRITER
// ============================================================

function rewriteMPD({
  mpd,
  finalURL,
  finalParsedURL,
  finalManifestDir,
  workerOrigin
}) {

  // ==========================================================
  // <Location>
  // ==========================================================

  mpd = mpd.replace(
    /<Location(\s[^>]*)?>([\s\S]*?)<\/Location>/gi,
    (full, attributes = "", value) => {

      const rewritten =
        rewriteURL(
          value.trim(),
          finalURL,
          finalParsedURL,
          workerOrigin
        );

      return (
        "<Location" +
        attributes +
        ">" +
        rewritten +
        "</Location>"
      );
    }
  );


  // ==========================================================
  // media="..."
  // ==========================================================

  mpd = mpd.replace(
    /(\smedia\s*=\s*)(["'])(.*?)\2/gi,
    (full, prefix, quote, value) => {

      const rewritten =
        rewriteURL(
          value,
          finalURL,
          finalParsedURL,
          workerOrigin,
          finalManifestDir
        );

      return (
        prefix +
        quote +
        rewritten +
        quote
      );
    }
  );


  // ==========================================================
  // initialization="..."
  // ==========================================================

  mpd = mpd.replace(
    /(\sinitialization\s*=\s*)(["'])(.*?)\2/gi,
    (full, prefix, quote, value) => {

      const rewritten =
        rewriteURL(
          value,
          finalURL,
          finalParsedURL,
          workerOrigin,
          finalManifestDir
        );

      return (
        prefix +
        quote +
        rewritten +
        quote
      );
    }
  );


  // ==========================================================
  // <BaseURL>
  // ==========================================================

  mpd = mpd.replace(
    /<BaseURL(\s[^>]*)?>([\s\S]*?)<\/BaseURL>/gi,
    (full, attributes = "", value) => {

      const rewritten =
        rewriteURL(
          value.trim(),
          finalURL,
          finalParsedURL,
          workerOrigin,
          finalManifestDir
        );

      return (
        "<BaseURL" +
        attributes +
        ">" +
        rewritten +
        "</BaseURL>"
      );
    }
  );


  return mpd;
}


// ============================================================
// URL REWRITER
// ============================================================

function rewriteURL(
  value,
  finalURL,
  finalParsedURL,
  workerOrigin,
  finalManifestDir
) {

  if (!value) {
    return value;
  }

  value = value.trim();

  try {

    // --------------------------------------------------------
    // Resolve relative URL berdasarkan FINAL URL
    // --------------------------------------------------------

    const resolvedURL =
      new URL(
        value,
        finalURL
      );

    // --------------------------------------------------------
    // URL dari upstream final origin
    // --------------------------------------------------------

    if (
      resolvedURL.origin ===
      finalParsedURL.origin
    ) {

      return (
        workerOrigin +
        resolvedURL.pathname +
        resolvedURL.search
      );
    }

    // --------------------------------------------------------
    // URL dari target CDN awal
    // --------------------------------------------------------

    if (
      resolvedURL.origin ===
      CONFIG.TARGET_CDN
    ) {

      return (
        workerOrigin +
        resolvedURL.pathname +
        resolvedURL.search
      );
    }

    // --------------------------------------------------------
    // URL external lain
    // Jangan rewrite
    // --------------------------------------------------------

    if (
      resolvedURL.protocol === "http:" ||
      resolvedURL.protocol === "https:"
    ) {
      return value;
    }

    // --------------------------------------------------------
    // Fallback
    // --------------------------------------------------------

    return (
      finalManifestDir +
      value
    );

  } catch {
    return value;
  }
}


// ============================================================
// CORS
// ============================================================

function applyCors(headers) {

  headers.set(
    "Access-Control-Allow-Origin",
    "*"
  );

  headers.set(
    "Access-Control-Allow-Methods",
    "GET,HEAD,OPTIONS"
  );

  headers.set(
    "Access-Control-Allow-Headers",
    "*"
  );

  headers.set(
    "Access-Control-Expose-Headers",
    [
      "Content-Length",
      "Content-Range",
      "Accept-Ranges",
      "Content-Type",
      "ETag"
    ].join(", ")
  );
}


function corsHeaders() {

  return {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods":
      "GET,HEAD,OPTIONS",
    "Access-Control-Allow-Headers": "*",
    "Access-Control-Expose-Headers":
      [
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "Content-Type",
        "ETag"
      ].join(", ")
  };
}
